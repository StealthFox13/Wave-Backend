<script>
require(['main'], function () {
  require(['jquery', 'utils', 'dialog_handlers', 'update_functions', 'float/main'], function ($, Utils, DialogHandlers, UpdateFunctions, Float) {
    var ajax_forms_handlers = DialogHandlers.ajax_forms_handlers,
      update_account_list = UpdateFunctions.update_account_list,
      UPDATE_FUNCS = UpdateFunctions;

    function format_price_currency() {
      //need to trim the string for server validation to accept an empty string with spaces
      var trimmed_price = jQuery.trim($('#id_price').val());

      if (trimmed_price != '') {
        num_decimals = 2;
        if (trimmed_price.indexOf('.') > -1) { // get the number of decimal places
          temp_num_decimals = trimmed_price.length - trimmed_price.indexOf('.') - 1;
          if (temp_num_decimals > num_decimals) {
            num_decimals = temp_num_decimals;
          }
        }
        trimmed_price = Float.Facade.Formatter.number(trimmed_price, num_decimals, '')
      }

      $('#id_price').val(trimmed_price);
	}

	$(function () {
      var price_field = $('#id_price');
      var pre;
      price_field.tooltip({ trigger: 'manual' });
      price_field.bind('keypress', function(event) {
        pre = price_field.val();
        var k = parseInt(event.which);
        // Only allow numbers (48-57), '-' (45), '.' (46), arrow/home/end/delete (0), and backspace (8)
        if ((k > 47 && k < 58) || k == 46 || k == 45 || k == 0 || k == 8) {
          if (k==46) {
            return price_field.val().lastIndexOf('.') == -1;
          }
          return true;
        }
        return false;
      });

      price_field.bind('keyup', function(event) {
        var value = price_field.val();
        var decimal_loc = value.lastIndexOf('.');
        if ((value.length - decimal_loc > 6) && (decimal_loc > -1)) {
          price_field.val(Utils.truncate_decimal(value, 5));
          price_field.tooltip('show');
          return true;
        } else if (value.lastIndexOf('-') > 0) {
          price_field.val(pre);
        }
        price_field.tooltip('hide');
        return true;
      });

      price_field.bind('blur', function(event) {
          price_field.tooltip('hide');
      });

      // enable ajax forms
      ajax_forms_handlers('product');

      $('#id_price').blur(format_price_currency);
      format_price_currency();
      // Update the account list when user adds a new account
      var url = wave.urls.ACCOUNT_DROPDOWN;
      _.map(['income', 'expense'], function (elem) {
        $('#id_' + elem + '_account').live('update_content', UPDATE_FUNCS.update_account_list(url + '?filter=' + elem.toUpperCase()));
      });
	});
  }); // require
}); // require

// Initialize tax widget on input field.
