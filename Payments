  <script>
    (function(){
      let scriptEle = document.createElement('script');
      const ChargebeeJsURL = 'https://dwdqz3611m4qq.cloudfront.net/static-assets/prod/global/assets/js/vendor/chargebee/chargebee.js';

      scriptEle.setAttribute('src', ChargebeeJsURL);
      scriptEle.setAttribute('type', 'text/javascript');
      scriptEle.setAttribute('async', '');

      document.body.appendChild(scriptEle);

      const initChargebee = (retries = 5, delay = 100) => {
        if (window.Chargebee) {
          window.Chargebee.init({
            site: "waveapps",
          });
        } else if (retries > 0) {
          console.log(`Chargebee: window.Chargebee is not defined, retrying in ${delay}ms...`);
          setTimeout(() => initChargebee(retries - 1, delay), delay);
        } else {
          console.error('Chargebee: Failed to initialize');
        }
      };

      scriptEle.addEventListener('load', () => {
        initChargebee();
      });

      scriptEle.addEventListener('error', (ev) => {
        console.log('Error on loading chargebee', ev);
      });
    })();
  </script>



